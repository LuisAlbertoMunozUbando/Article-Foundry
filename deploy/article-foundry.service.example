[Unit]
Description=Article Foundry
After=network.target

[Service]
Type=simple
User=alberto
WorkingDirectory=/home/alberto/Article-Foundry
EnvironmentFile=/home/alberto/Article-Foundry/.env
ExecStart=/home/alberto/Article-Foundry/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8040
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
